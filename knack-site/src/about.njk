---
layout: base.njk
permalink: about.html
title: About
nav: about
---
<section class="page-head">
  <div class="wrap split split-top">
    <img class="split-img tall" src="{{ about.portrait | rel(page.url) }}" alt="Kimberly Castillo">
    <div class="split-text">
      <p class="eyebrow mono">About</p>
      <h1 class="marquee marquee-md">{{ about.heading }}</h1>
      <div class="prose">
        {% for para in about.body.split("\n\n") %}<p>{{ para }}</p>{% endfor %}
      </div>
      <dl class="facts">
        {% for f in about.facts %}<div><dt class="mono">{{ f.label }}</dt><dd>{{ f.value }}</dd></div>{% endfor %}
      </dl>
      <a class="btn btn-gel" href="{{ '/contact.html' | rel(page.url) }}">Let's work together</a>
    </div>
  </div>
</section>
