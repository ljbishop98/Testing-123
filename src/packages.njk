---
layout: base.njk
permalink: packages.html
title: Packages
nav: packages
---
<section class="page-head">
  <div class="wrap">
    <p class="eyebrow mono">Pricing</p>
    <h1 class="marquee marquee-md">Packages</h1>
    <p class="lede">{{ packages.intro }}</p>
  </div>
</section>
{% for grp in packages.groups %}
<section class="section section-tight">
  <div class="wrap">
    <h2 class="h2">{{ grp.name }}</h2>
    <div class="tiers">
      {% for t in grp.tiers %}
      <article class="tier{% if t.featured %} tier-featured{% endif %}">
        <h3 class="tier-name">{{ t.name }}</h3>
        <p class="tier-price">{{ t.price }}</p>
        <p class="mono tier-len">{{ t.length }}</p>
        <ul>{% for i in t.items %}<li>{{ i }}</li>{% endfor %}</ul>
      </article>
      {% endfor %}
    </div>
    {% if grp.note %}<p class="note mono">{{ grp.note }}</p>{% endif %}
  </div>
</section>
{% endfor %}
<section class="section cta-band">
  <div class="wrap cta-in">
    <h2 class="marquee marquee-sm">Concerts, conferences & custom shoots</h2>
    <a class="btn btn-gel" href="{{ '/contact.html' | rel(page.url) }}">Request a quote</a>
  </div>
</section>
