---
layout: base.njk
permalink: index.html
isHome: true
---
{% set inquire = contact.honeybook_link or '#contact' %}
{% set ext = ' target="_blank" rel="noopener"' if contact.honeybook_link else '' %}
<div id="top" class="cover">
  <div class="cover-shot"><img src="{{ site.portrait | rel(page.url) }}" alt="{{ site.portrait_alt }}"></div>
  <div class="lines">
    <div class="cell who">
      <p class="label">{{ site.role }}</p>
      <h1 class="name">{{ site.owner }}</h1>
    </div>
    <div class="cell">
      <p class="statement">{{ site.statement }}</p>
    </div>
    <nav class="cell cl" aria-label="In this issue">
      <a href="#works"><span class="t">{{ home.heading }}</span><span class="s">{% for c in home.chapters %}{{ c.title | replace(" & worship nights", "") }}{% if not loop.last %} &middot; {% endif %}{% endfor %}</span><span class="arr" aria-hidden="true">&rarr;</span></a>
      <a href="#pricing"><span class="t">{{ pricing.heading }}</span><span class="s">{{ pricing.label }}</span><span class="arr" aria-hidden="true">&rarr;</span></a>
      <a href="#galleries"><span class="t">Galleries</span><span class="s">{{ collections.galleries.length }} albums</span><span class="arr" aria-hidden="true">&rarr;</span></a>
    </nav>
  </div>
</div>

<section id="works">
  <div class="sec-head">
    <h2>{{ home.heading }}</h2>
    <p class="label">{{ home.label }}</p>
  </div>
  <div class="tabs" role="tablist" aria-label="Kinds of day" style="--n: {{ home.chapters.length }}" hidden>
    {% for ch in home.chapters %}<button class="tab" role="tab" id="tab-{{ loop.index }}" aria-controls="ch-{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}"><span class="tab-no">{{ loop.index | roman }}</span><span class="tab-t">{{ ch.title }}</span><span class="tab-s">{{ ch.label }}</span></button>{% endfor %}
  </div>
  {% for ch in home.chapters %}
  <div class="chapter" id="ch-{{ loop.index }}" role="tabpanel" aria-labelledby="tab-{{ loop.index }}">
    <div class="chapter-head"><h3>{{ ch.title }}</h3><p class="label">{{ ch.label }}</p></div>
    <div class="sheet" data-lightbox>
      {% for p in ch.photos %}
      <button class="tile shot" data-src="{{ p.image | rel(page.url) }}" data-caption="{{ p.caption }}" aria-label="Open {{ p.caption or ch.title }} photo">
        <img src="{{ p.image | rel(page.url) }}" {{ p.image | dims | safe }} alt="{{ ch.title }}{% if p.caption %}, {{ p.caption }}{% endif %}" loading="lazy">
        <span class="cap"><span class="no">{{ loop.index | roman }}</span>{% if p.caption %}<span class="t">{{ p.caption }}</span>{% endif %}</span>
      </button>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
</section>

<section id="galleries">
  <div class="sec-head">
    <h2>Galleries</h2>
    <a class="label sec-link" href="{{ '/work.html' | rel(page.url) }}">All {{ collections.galleries.length }} albums &rarr;</a>
  </div>
  <div class="album-grid album-teaser">
    {% for g in collections.galleries | homeGalleries %}
    <a class="album reveal" href="{{ g.url | rel(page.url) }}">
      <span class="tile album-img"><img src="{{ g.data.cover | rel(page.url) }}" alt="" loading="lazy"></span>
      <span class="meta"><span class="label">{{ g.data.category }}</span><span class="t">{{ g.data.title }}</span></span>
    </a>
    {% endfor %}
  </div>
</section>

<section id="pricing">
  <div class="sec-head">
    <h2>{{ pricing.heading }}</h2>
    <p class="label">{{ pricing.label }}</p>
  </div>
  <div class="rows">
    {% for r in pricing.rows %}
    <div class="row reveal">
      <div><span class="no">No. {{ loop.index }}</span><h3>{{ r.name }}</h3></div>
      <p class="d">{{ r.description }}</p>
      <div class="buy">
        <div class="price"><small>Starting at</small>{{ r.price }}{% if r.unit %}<span class="unit">{{ r.unit }}</span>{% endif %}</div>
        <a class="btn{% if not r.primary %} ghost{% endif %}" href="{{ inquire }}"{{ ext | safe }}>{{ r.button or 'Inquire' }}</a>
      </div>
    </div>
    {% endfor %}
  </div>
  <div class="also">
    {% for c in pricing.cards %}
    <div class="card">
      <span class="label">{{ c.label }}</span>
      <h3>{{ c.title }}</h3>
      {% if c.tags.length %}<div class="tags">{% for t in c.tags %}<span>{{ t }}</span>{% endfor %}</div>{% endif %}
      <p>{{ c.text }}</p>
      <a class="btn ghost" href="{{ inquire }}"{{ ext | safe }}>Inquire</a>
    </div>
    {% endfor %}
  </div>
</section>

<section id="reviews">
  <div class="sec-head">
    <h2>{{ reviews.heading }}</h2>
    <p class="label">{{ reviews.label }}</p>
  </div>
  {% set shown = reviews.reviews | selectattr("show") %}
  {% if shown.length %}
  <div class="quotes">
    {% for r in shown %}
    <figure class="quote reveal">
      <blockquote>{{ r.quote }}</blockquote>
      <figcaption><span class="q-name">{{ r.name }}</span>{% if r.occasion %}<span class="label">{{ r.occasion }}</span>{% endif %}</figcaption>
    </figure>
    {% endfor %}
  </div>
  {% endif %}

  <div class="review-box{% if shown.length %} review-box-after{% endif %}">
    <div class="review-intro">
      <h3>{{ reviews.form_heading }}</h3>
      <p>{{ reviews.form_text }}</p>
    </div>
    <form class="review-form" name="review" method="POST" action="{{ '/thanks.html' | rel(page.url) }}" data-netlify="true" netlify-honeypot="company">
      <input type="hidden" name="form-name" value="review">
      <p class="hp"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off"></label></p>
      <div class="f-row">
        <label class="f"><span class="label">Your name</span><input id="rv-name" name="name" required autocomplete="name"></label>
        <label class="f"><span class="label">Email (stays private)</span><input id="rv-email" name="email" type="email" required autocomplete="email"></label>
      </div>
      <label class="f"><span class="label">What did we shoot?</span>
        <select id="rv-type" name="occasion" required>
          <option value="">Choose one</option>
          {% for c in categories %}<option>{{ c }}</option>{% endfor %}
          <option>Something else</option>
        </select>
      </label>
      <label class="f"><span class="label">Your review</span><textarea id="rv-text" name="review" rows="5" required></textarea></label>
      <label class="check"><input id="rv-ok" type="checkbox" name="ok_to_share" value="yes"> <span>It's okay to share my review and first name on this site.</span></label>
      <button class="btn" type="submit">Send review</button>
      <p class="form-msg" role="status" hidden></p>
    </form>
  </div>
</section>

{% set liveFilms = films.films | selectattr("url") %}
{% if liveFilms.length %}
<section id="films">
  <div class="sec-head">
    <h2>{{ films.heading }}</h2>
    <p class="label">{{ films.label }}</p>
  </div>
  <div class="films">
    {% for f in liveFilms %}
    <a class="film" {% if f.url %}href="{{ f.url }}" target="_blank" rel="noopener"{% else %}aria-disabled="true"{% endif %}>
      <div class="tile film-tile">
        {% if f.thumbnail %}<img src="{{ f.thumbnail | rel(page.url) }}" alt="" loading="lazy">{% else %}<span class="ph">Film coming soon</span>{% endif %}
        <span class="play" aria-hidden="true"></span>
      </div>
      <div class="meta"><span class="label">{{ f.label }}</span><span class="t">{{ f.title }}</span>{% if f.url %}<span class="s">Opens in a new tab</span>{% endif %}</div>
    </a>
    {% endfor %}
  </div>
</section>

{% endif %}

<section id="contact">
  <div class="contact">
    <h2>{{ contact.contact_heading | em | safe }}</h2>
    <div class="row2">
      <p>{{ contact.contact_text }}</p>
      {% if contact.honeybook_link %}<a class="btn block" href="{{ contact.honeybook_link }}" target="_blank" rel="noopener">Start your inquiry</a>{% endif %}
    </div>
    {% if contact.honeybook_embed %}
      <div class="embed">{{ contact.honeybook_embed | safe }}</div>
    {% elif not contact.honeybook_link %}
      <div class="contact-fallback">
        {% if contact.email %}<a class="btn" href="mailto:{{ contact.email }}">Email me</a>{% endif %}
        {% if contact.instagram %}<a class="btn ghost" href="https://instagram.com/{{ contact.instagram }}" target="_blank" rel="noopener">Message @{{ contact.instagram }}</a>{% endif %}
      </div>
    {% endif %}
  </div>
</section>
