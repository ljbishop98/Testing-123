---
layout: base.njk
nav: work
---
<section class="first">
  <a class="back label" href="{{ '/work.html' | rel(page.url) }}">← All galleries</a>
  <div class="sec-head">
    <h1 class="h-sec">{{ title }}</h1>
    <p class="label">{{ category }} &middot; {{ date | year }}{% if location %} &middot; {{ location }}{% endif %} &middot; {{ photos.length }} photos</p>
  </div>
  {% if description %}<p class="statement gallery-desc">{{ description }}</p>{% endif %}
  {% if content | trim %}<div class="prose">{{ content | safe }}</div>{% endif %}
  <div class="masonry" data-lightbox>
    {% for p in photos %}{% set src = p.image if p.image else p %}
    <button class="shot" data-src="{{ src | rel(page.url) }}" data-caption="" aria-label="Open photo {{ loop.index }}">
      <img src="{{ src | rel(page.url) }}" alt="{{ title }} photo {{ loop.index }}" loading="lazy">
    </button>
    {% endfor %}
  </div>
</section>
<section id="contact">
  <div class="contact">
    <h2>{{ site.contact_heading | em | safe }}</h2>
    <div class="row2">
      <p>{{ site.contact_text }}</p>
      <a class="btn block" href="{{ site.honeybook_link or ('/index.html#contact' | rel(page.url)) }}"{% if site.honeybook_link %} target="_blank" rel="noopener"{% endif %}>Start your inquiry</a>
    </div>
  </div>
</section>
