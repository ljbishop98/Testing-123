<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.statement | truncate(155) }}">
  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ site.name }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Jost:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="{{ '/assets/style.css' | rel(page.url) }}">
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" defer></script>
</head>
<body class="{{ bodyClass }}">
  {% set homeUrl = '/index.html' | rel(page.url) %}
  {% set inquire = contact.honeybook_link or (homeUrl + '#contact') %}
  <a class="skip" href="#main">Skip to content</a>
  <div class="wrap">
    <div class="strip">
      <span class="label strap">{{ site.strap }}</span>
      <nav class="nav" aria-label="Sections">
        <a href="{{ homeUrl }}#top">Info</a>
        <a href="{{ homeUrl }}#works">Your day</a>
        <a href="{{ '/work.html' | rel(page.url) }}"{% if nav == 'work' %} aria-current="page"{% endif %}>Galleries</a>
        <a href="{{ homeUrl }}#pricing">Pricing</a>
        {% if (films.films | selectattr("url")).length %}<a href="{{ homeUrl }}#films">Films</a>{% endif %}
        <a class="inq" href="{{ inquire }}"{% if contact.honeybook_link %} target="_blank" rel="noopener"{% endif %}>Inquire</a>
      </nav>
    </div>

    <header class="mast{% if not isHome %} mast-sm{% endif %}">
      <a href="{{ homeUrl }}" class="mast-link" aria-label="{{ site.name }} home"><p id="mega" class="mega"><span class="l">Knack for</span> <span class="l">Creativity</span></p></a>
    </header>

    <main id="main">
      {{ content | safe }}
    </main>

    <footer class="foot">
      <span>&copy; {{ "now" | year }} {{ site.owner }} &middot; {{ site.name }}</span>
      <span class="foot-r">
        {% if contact.instagram %}<a href="https://instagram.com/{{ contact.instagram }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
        {% if contact.email %}<a href="mailto:{{ contact.email }}">{{ contact.email }}</a>{% endif %}
        <span>Inquiries through HoneyBook</span>
        <a href="/admin/">Admin</a>
      </span>
    </footer>
  </div>

  <div class="lightbox" id="lightbox" hidden>
    <button class="lb-close" id="lbClose">Close</button>
    <button class="lb-nav lb-prev" id="lbPrev" aria-label="Previous photo">‹</button>
    <figure><img id="lbImg" alt=""><figcaption id="lbCap" class="label"></figcaption></figure>
    <button class="lb-nav lb-next" id="lbNext" aria-label="Next photo">›</button>
  </div>

  <script src="{{ '/assets/site.js' | rel(page.url) }}"></script>
</body>
</html>
